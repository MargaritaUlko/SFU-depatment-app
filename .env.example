# Database
DATABASE_URL=postgresql+asyncpg://dept_user:dept_pass@localhost:5432/department_db
POSTGRES_USER=dept_user
POSTGRES_PASSWORD=dept_pass
POSTGRES_DB=department_db

# JWT
SECRET_KEY=change-me-to-a-64-character-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Files
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Reverse proxy prefix (оставьте пустым при локальном запуске)
# Пример для сервера: ROOT_PATH=/apis/department
ROOT_PATH=

# Schedule cache
SCHEDULE_CACHE_TTL=3600
SCHEDULE_CACHE_SIZE=512

# SMTP (оставьте пустыми — письма не будут отправляться, но ошибки не будет)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
